# Copy to .env.betfair (ignored), fill locally, then load it into your shell.
# Empty credentials make Betfair inactive; no network request is made.
BETFAIR_ENABLED=0
BETFAIR_APP_KEY=
# Choose an existing session token OR certificate login, not both.
BETFAIR_SESSION_TOKEN=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_CERT_FILE=
BETFAIR_KEY_FILE=
# nz: Australian identity and NZ .com.au betting API.
# au: Australian identity, global betting API. global: .com identity/API.
BETFAIR_REGION=nz
# Account currency, e.g. AUD/NZD/GBP. Leave empty when unknown.
BETFAIR_CURRENCY=
# Describe the key you have. Default unknown; never inferred from credentials.
BETFAIR_DATA_MODE=unknown
# Exact basketball competition names, comma-separated. NBA is this milestone.
BETFAIR_LEAGUES=NBA
BETFAIR_LOOKAHEAD_HOURS=72
BETFAIR_CATALOGUE_INTERVAL=900
# Explicit test-only replay, never enabled automatically:
BETFAIR_REPLAY_FILE=
